# Copy this file to `.env` and replace the placeholders before running the gateway.
# `.env` is ignored by Git.

MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=orchard/soil/#

GATEWAY_STORAGE_DIR=./data

ORACLE_SOIL_API_URL=https://your-oracle-host/ords/orcharddss/orchard/sensors/soil
ORACLE_API_SUCCESS_CODE=200
ORACLE_API_TIMEOUT=10

SYNC_INTERVAL_SECONDS=60
